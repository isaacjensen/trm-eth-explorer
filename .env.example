# Copy to .env for local dev (.env is gitignored). The Infura key is a secret.
INFURA_API_KEY=your-infura-key-here
INFURA_NETWORK=mainnet
PORT=3000
LOG_LEVEL=info
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_RETRIES=1

# Optional: when set, the balance route requires a valid HS256 bearer JWT signed with
# this secret. Leave unset to run the endpoint open (dev). Treated as a secret in prod.
# AUTH_JWT_SECRET=change-me
# AUTH_JWT_AUDIENCE=trm-eth-explorer
# AUTH_JWT_ISSUER=https://your-idp.example.com/
# Scope required on the token (authorization). Overridable, defaults to balance:read.
# AUTH_REQUIRED_SCOPE=balance:read

# Optional: mint-token.js reads the signing secret from this Secrets Manager secret
# (using your local AWS creds) instead of AUTH_JWT_SECRET. Requires: source .aws-local/env.sh
# APP_SECRET_ID=trm-eth-explorer/app
